@model IEnumerable<AracKiralamaApp.Models.Musteri>
@{
    ViewData["Title"] = "Müşteri Listesi";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="m-0">Müşteri Yönetimi</h1>
        <p class="text-muted">Sistemdeki tüm kayıtlı müşterileri görüntüleyin, güncelleyin veya yeni müşteri kaydedin.</p>
    </div>
    <a class="btn btn-primary-custom" asp-action="Create">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
        Yeni Müşteri Ekle
    </a>
</div>

<div class="custom-card">
    @if (!Model.Any())
    {
        <div class="text-center py-5 text-muted">
            Kayıtlı müşteri bulunmuyor. Yeni bir tane ekleyerek başlayın.
        </div>
    }
    else
    {
        <div class="table-responsive table-container border-0">
            <table class="table table-custom">
                <thead>
                    <tr>
                        <th>Ad Soyad</th>
                        <th>T.C. Kimlik No</th>
                        <th>Ehliyet No</th>
                        <th>Telefon</th>
                        <th>E-posta</th>
                        <th>Risk Skoru</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <strong>@item.AdSoyad</strong>
                                @if (item.Blacklist)
                                {
                                    <span class="badge badge-custom badge-danger ms-1" style="font-size: 0.7rem; padding: 0.2em 0.5em;">KARA LİSTE</span>
                                }
                            </td>
                            <td>@item.TcNo</td>
                            <td>@item.EhliyetNo</td>
                            <td>@item.Telefon</td>
                            <td>@item.Email</td>
                            <td>
                                <span class="badge badge-custom @(item.RiskSkoru > 50 ? "badge-danger" : (item.RiskSkoru > 20 ? "badge-yellow" : "badge-success")) font-monospace">
                                    @item.RiskSkoru / 100
                                </span>
                                @if (item.RiskSkoru > 50)
                                {
                                    <i class="fa-solid fa-triangle-exclamation text-danger ms-1" title="Yüksek Risk Skoru!"></i>
                                }
                            </td>
                            <td>
                                <div class="d-flex gap-2">
                                    <a class="btn btn-secondary-custom btn-sm py-1 px-2" asp-action="Edit" asp-route-id="@item.MusteriId">Düzenle</a>
                                    <a class="btn btn-danger-custom btn-sm py-1 px-2" asp-action="Delete" asp-route-id="@item.MusteriId">Sil</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
