@model AracKiralamaApp.Models.Musteri
@{
    ViewData["Title"] = "Müşteri Sil";
}

<div class="mb-4">
    <a class="text-muted text-decoration-none small d-inline-flex align-items-center gap-1 mb-2" asp-action="Index">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        Müşteri Listesine Dön
    </a>
    <h1 class="m-0 text-danger">Müşteriyi Sil</h1>
    <p class="text-muted">Bu müşteriyi silmek istediğinize emin misiniz? Bu işlem geri alınamaz.</p>
</div>

<div class="row">
    <div class="col-md-8 col-lg-6">
        <div class="custom-card border-danger">
            <h4 class="mb-3 text-white">Müşteri Detayları</h4>
            <div class="mb-2"><strong>Ad Soyad:</strong> @Model.AdSoyad</div>
            <div class="mb-2"><strong>T.C. Kimlik No:</strong> @Model.TcNo</div>
            <div class="mb-2"><strong>Ehliyet No:</strong> @Model.EhliyetNo</div>
            <div class="mb-2"><strong>Telefon:</strong> @Model.Telefon</div>
            <div class="mb-4"><strong>E-posta:</strong> @Model.Email</div>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="MusteriId" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger flex-grow-1 py-2 font-weight-bold">Evet, Müşteriyi Sil</button>
                    <a class="btn btn-secondary-custom" asp-action="Index">Vazgeç</a>
                </div>
            </form>
        </div>
    </div>
</div>
